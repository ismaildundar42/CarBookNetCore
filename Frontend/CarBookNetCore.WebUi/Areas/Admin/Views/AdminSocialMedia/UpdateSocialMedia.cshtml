@model UpdateSocialMediaDto
@{
    ViewData["Title"] = "UpdateSocialMedia";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Sosyal Medya Güncelleme Sayfası</h4>
                        <p class="card-subtitle mb-4">Sosyal Medya bilgileri aşadağıki kutucağa girebilirsiniz. Veri girişinden sonra kaydet butonuna tıklayarak işlemi tamamlayabilirsiniz.</p>
                        <form method="post">

                            <div class="form-group">

                                <input type="hidden" asp-for="SocialMediaId" />

                                <label for="exampleInputName">Sosyal Medya</label>
                                <input type="text" class="form-control" id="exampleInputName1" asp-for="Name" placeholder="Sosyal Medya Girişi Yapınız">
                            </div>


                            <div class="form-group">
                                <label for="exampleInputName">Url</label>
                                <input type="text" class="form-control" id="exampleInputName1" asp-for="Url" placeholder=" Url Girişi Yapınız">
                            </div>

                            <div class="form-group">
                                <label for="exampleInputName">Icon</label>
                                <input type="text" class="form-control" id="exampleInputName1" asp-for="Icon" placeholder=" Icon Girişi Yapınız">
                            </div>

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Sosyal Medya Bilgisi Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>









