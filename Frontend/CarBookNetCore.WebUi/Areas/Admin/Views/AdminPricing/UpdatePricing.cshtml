@model UpdatePricingDto
@{
    ViewData["Title"] = "UpdatePricing";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Ödeme Türü Güncelleme Sayfası</h4>
                        <p class="card-subtitle mb-4">Ödeme Türü bilgileri aşadağıki kutucağa girebilirsiniz. Veri girişinden sonra kaydet butonuna tıklayarak işlemi tamamlayabilirsiniz.</p>
                        <form method="post">

                            <div class="form-group">

                                <input type="hidden" asp-for="PricingId" />

                                <label for="exampleInputName">Ödeme Türü Bilgisi</label>
                                <input type="text" class="form-control" id="exampleInputName1" asp-for="Name" placeholder="Ödeme Türü Girişi Yapınız">
                            </div>

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Ödeme Türü Güncelle Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>







