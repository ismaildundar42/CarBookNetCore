@model CreateAboutDto

@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni Hakkımda Girişi</h4>
                        <p class="card-subtitle mb-4">Hakkımda bilgileri aşadağıki kutucağa girebilirsiniz. Veri girişinden sonra kaydet butonuna tıklayarak işlemi tamamlayabilirsiniz.</p>
                        <form method="post">

                            <div class="form-group">
                                <label for="exampleInputName">Başlık Bilgisi</label>
                                <input type="text" class="form-control" id="exampleInputName1" asp-for="title" placeholder="Başlık Girişi Yapınız">
                            </div>

                            <div class="form-group">
                                <label for="exampleInputName">Açıklama Bilgisi</label>
                                <textarea class="form-control" asp-for="description" placeholder="Açıklama Bilgisi Giriniz" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <label for="exampleInputName">Image Url</label>
                                <input type="text" class="form-control" id="exampleInputName1" asp-for="imageUrl" placeholder="Image Url Girişi Yapınız">
                            </div>

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Hakkımda Bilgisi Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



