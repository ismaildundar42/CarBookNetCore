@model UpdateAuthorDto
@{
    ViewData["Title"] = "UpdateAuthor";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yazar Güncelleme Sayfası</h4>
                        <p class="card-subtitle mb-4">Yazar bilgileri aşadağıki kutucağa girebilirsiniz. Veri girişinden sonra kaydet butonuna tıklayarak işlemi tamamlayabilirsiniz.</p>
                        <form method="post">

                            <input type="hidden" asp-for="AuthorId" />

                            <div class="form-group">
                                <label for="exampleInputName">Yazar Ad Soyad</label>
                                <input type="text" class="form-control" id="exampleInputName1" asp-for="Name" placeholder="Yazar Ad Soyad Girişi Yapınız">
                            </div>

                            <div class="form-group">
                                <label for="exampleInputName">Açıklama Bilgisi</label>
                                <textarea class="form-control" asp-for="Description" placeholder="Açıklama Bilgisi Giriniz" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <label for="exampleInputName">Image Url</label>
                                <input type="text" class="form-control" id="exampleInputName1" asp-for="ImageUrl" placeholder="Image Url Girişi Yapınız">
                            </div>

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Yazar Bilgisi Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>







