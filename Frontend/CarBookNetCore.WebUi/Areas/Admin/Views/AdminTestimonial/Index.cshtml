@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">
                <div class="Testimoniald">
                    <div class="Testimoniald-body">
                        <h4 class="Testimoniald-title">Referans Listesi</h4>
                        <p class="Testimoniald-subtitle mb-4">
                            Referanslar ile ilgili Ekleme,Silme,Güncelleme işlemleri bu ekrandan gerçekleştirebilirsiniz.
                            <code>&lt;table&gt;</code>.
                        </p>
                        <br />
                        <td><a href="/Admin/AdminTestimonial/CreateTestimonial/" class="btn btn-outline-success">Referans Ekle</a></td>
                        <br />
                        <br />
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Ad Soyad</th>
                                        <th>Unvan</th>
                                        <th>Yorum</th>
                                        <th>ImageUrl</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var x in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <td>@x.Name</td>
                                            <td>@x.Title</td>
                                            <td>@x.Comment</td>
                                            <td><img src="@x.ImageUrl" width="50" height="50" style="margin-right:10px" @x.Name /></td>
                                            <td><a href="/Admin/AdminTestimonial/DeleteTestimonial/@x.TestimonialId" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/Admin/AdminTestimonial/UpdateTestimonial/@x.TestimonialId" class="btn btn-outline-primary">Güncelle</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <!-- end Testimoniald-body-->
                </div>
                <!-- end Testimoniald -->

            </div>

        </div>

    </div> <!-- container-fluid -->
</div>







