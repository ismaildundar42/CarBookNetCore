@model List<ResultFooterAddressDto>


@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">
                <div class="FooterAddressd">
                    <div class="FooterAddressd-body">
                        <h4 class="FooterAddressd-title">Yazar Listesi</h4>
                        <p class="FooterAddressd-subtitle mb-4">
                            Footer Address ile ilgili Ekleme,Silme,Güncelleme işlemleri bu ekrandan gerçekleştirebilirsiniz.
                            <code>&lt;table&gt;</code>.
                        </p>
                        <br />
                        <td><a href="/Admin/AdminFooterAddress/CreateFooterAddress/" class="btn btn-outline-success">Footer Address Ekle</a></td>
                        <br />
                        <br />
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Açıklama</th>
                                        <th>Adres</th>
                                        <th>Telefon</th>
                                        <th>Email</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var x in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <td>@x.Description</td>
                                            <td>@x.Address</td>
                                            <td>+ @x.Phone</td>
                                            <td>@x.Email</td>
                                            <td><a href="/Admin/AdminFooterAddress/DeleteFooterAddress/@x.FooterAddressId" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/Admin/AdminFooterAddress/UpdateFooterAddress/@x.FooterAddressId" class="btn btn-outline-primary">Güncelle</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <!-- end FooterAddressd-body-->
                </div>
                <!-- end FooterAddressd -->

            </div>

        </div>

    </div> <!-- container-fluid -->
</div>







