@model List<ResultCommentDto>

<ul class="comment-list">
    @foreach (var x in Model)
    {
        <li class="comment">
            <div class="vcard bio">
                <img src="https://ui-avatars.com/api/?name=@x.Name&background=0D8ABC&color=fff&size=80"
                     alt="@x.Name">
            </div>
            <div class="comment-body">
                <h3>@x.Name</h3>
                <div class="meta">
                    @x.CreatedDate.ToString("dd MMMM yyyy • HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
            </div>                <p>@x.Description</p>
            </div>
        </li>
    }
</ul>
