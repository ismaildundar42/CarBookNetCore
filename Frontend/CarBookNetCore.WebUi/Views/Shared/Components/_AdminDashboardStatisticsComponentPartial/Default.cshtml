<div class="row">
    <div class="col-md-6 col-xl-3 mb-4">
        <div class="card stat-card stat-card-1">
            <div class="stat-card-title">Toplam Araç Sayısı</div>
            <div class="stat-card-value">@ViewBag.CarCount</div>
        </div>
    </div> <!-- end col-->

    <div class="col-md-6 col-xl-3 mb-4">
        <div class="card stat-card stat-card-2">
            <div class="stat-card-title">Toplam Lokasyon Sayısı</div>
            <div class="stat-card-value">@ViewBag.LocationCount</div>
        </div>
    </div> <!-- end col-->

    <div class="col-md-6 col-xl-3 mb-4">
        <div class="card stat-card stat-card-3">
            <div class="stat-card-title">Toplam Yazar Sayısı</div>
            <div class="stat-card-value">@ViewBag.AuthorCount</div>
        </div>
    </div> <!-- end col-->

    <div class="col-md-6 col-xl-3 mb-4">
        <div class="card stat-card stat-card-4">
            <div class="stat-card-title">Toplam Blog Sayısı</div>
            <div class="stat-card-value">@ViewBag.BlogCount</div>
        </div>
    </div> <!-- end col-->
</div>