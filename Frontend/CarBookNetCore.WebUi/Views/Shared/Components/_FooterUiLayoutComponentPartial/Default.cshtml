@model List<ResultFooterAddressDto>

@foreach (var x in Model)
{
	<footer class="ftco-footer ftco-bg-dark ftco-section">
		<div class="container">
			<div class="row mb-5">
				<div class="col-md">
					<div class="ftco-footer-widget mb-4">
						<h2 class="ftco-heading-2"><a href="#" class="logo">Car<span>book</span></a></h2>
						<p>@x.Description</p>
						<ul class="ftco-footer-social list-unstyled float-md-left float-lft mt-5">
							<li class="ftco-animate"><a href="#"><span class="icon-twitter"></span></a></li>
							<li class="ftco-animate"><a href="#"><span class="icon-facebook"></span></a></li>
							<li class="ftco-animate"><a href="#"><span class="icon-instagram"></span></a></li>
						</ul>
					</div>
				</div>
				<div class="col-md">
					<div class="ftco-footer-widget mb-4 ml-md-5">
						<h2 class="ftco-heading-2">Hızlı Linkler</h2>
						<ul class="list-unstyled">
							<li><a href="/About/Index/" class="py-2 d-block">Hakkımızda</a></li>
							<li><a href="/Car/Index/" class="py-2 d-block">Hizmetlerimiz</a></li>
							<!-- id="btnSartlar" yerine class="btn-sartlar" olarak güncellendi -->
							<li><a href="javascript:void(0)" class="btn-sartlar py-2 d-block">Şartlar ve Koşullar</a></li>
							<li><a href="javascript:void(0)" class="btn-guvenlik py-2 d-block">Güvenlik</a></li>
							<li><a href="javascript:void(0)" class="btn-cerez py-2 d-block">Çerez Politikası</a></li>
						</ul>
					</div>
				</div>
				<div class="col-md">
					<div class="ftco-footer-widget mb-4">
						<h2 class="ftco-heading-2">Müşteri Desteği</h2>
						<ul class="list-unstyled">
							<li><a href="javascript:void(0)" class="btn-sss py-2 d-block">Sıkça Sorulanlar</a></li>
							<li><a href="javascript:void(0)" class="btn-odeme py-2 d-block">Ödeme Yöntemleri</a></li>
							<li><a href="/RentACarList/Index/" class="py-2 d-block">Kiralama</a></li>
							<li><a href="javascript:void(0)" class="btn-nasil-calisir py-2 d-block">Nasıl Çalışır?</a></li>
							<li><a href="#" class="py-2 d-block">Bize Yazın</a></li>
						</ul>
					</div>
				</div>
				<div class="col-md">
					<div class="ftco-footer-widget mb-4">
						<h2 class="ftco-heading-2">Bir sorunuz mu var?</h2>
						<div class="block-23 mb-3">
							<ul>
								<li><span class="icon icon-map-marker"></span><span class="text">@x.Address</span></li>
								<li><span class="icon icon-phone"></span><span class="text">@x.Phone</span></li>
								<li><span class="icon icon-envelope"></span><span class="text">@x.Email</span></li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-md-12 text-center">
					<p>
						Copyright &copy;<script>document.write(new Date().getFullYear());</script> Tüm Hakları Saklıdır
					</p>
				</div>
			</div>
		</div>
	</footer>
}

<!-- loader -->
<div id="ftco-loader" class="show fullscreen">
	<svg class="circular" width="48px" height="48px">
		<circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee" />
		<circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#F96D00" />
	</svg>
</div>

<!-- 1. jQuery kütüphanesinin yuklendiğinden emin oluyoruz -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- 2. SweetAlert CDN -->
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

<!-- 3. Event Listener Script'i -->
<script>
	$(document).ready(function () {
		$(document).on('click', '.btn-sartlar', function (e) {
			e.preventDefault();

			swal({
				title: "Şartlar ve Koşullar",
				text: "CarBook üzerinden gerçekleştirilen araç kiralama işlemlerinde kullanıcıların geçerli sürücü belgesine sahip olması, belirtilen yaş ve ödeme koşullarını karşılaması gerekmektedir. Kiralama süresi, teslim ve iade şartları seçilen araca göre değişiklik gösterebilir.",
				icon: "info",
				button: "Tamam"
			});
		});

			$(document).on('click', '.btn-guvenlik', function (e) {
		e.preventDefault();

		swal({
			title: "Güvenlik Politikamız",
			text: "CarBook, kullanıcı verilerinin ve ödeme işlemlerinin güvenliğini en üst düzeyde tutar. Tüm kişisel verileriniz SSL sertifikaları ve güncel güvenlik protokolleri ile korunmaktadır.",
			icon: "info",
			button: "Tamam"
		});
	});

		$(document).on('click', '.btn-cerez', function (e) {
		e.preventDefault();

		swal({
			title: "Çerez Politikası",
			text: "Web sitemizde deneyiminizi geliştirmek, site kullanımını analiz etmek ve kişiselleştirilmiş içerik sunmak amacıyla çerezler kullanılmaktadır. Sitemizi kullanmaya devam ederek çerez kullanımını kabul etmiş olursunuz.",
			icon: "info",
			button: "Anladım"
		});
	});

		$(document).on('click', '.btn-odeme', function (e) {
		e.preventDefault();

		swal({
			title: "Ödeme Yöntemleri",
			text: "Kiralama işlemlerinizde tüm ana kredi kartları (Visa, MasterCard, AMEX) ve banka kartları geçerlidir. Güvenli ödeme altyapımız sayesinde işlemleriniz 3D Secure güvencesiyle gerçekleştirilir. Araç teslimatında nakit ödeme seçeneğimiz de mevcuttur.",
			icon: "info",
			button: "Anladım"
		});
	});

		$(document).on('click', '.btn-nasil-calisir', function (e) {
		e.preventDefault();

		swal({
			title: "Nasıl Çalışır?",
			text: "1. Aracınızı ve kiralama tarihlerini seçin.\n2. Uygun lokasyondan teslim alma noktasını belirleyin.\n3. Saniyeler içinde güvenli rezervasyonunuzu tamamlayın ve aracınızı teslim alın!",
			icon: "info",
			button: "Anladım"
		});
	});

		$(document).on('click', '.btn-sss', function (e) {
		e.preventDefault();

		swal({
			title: "Sıkça Sorulan Sorular",
			text: "• Araç kiralamak için minimum yaş sınırı 21'dir.\n• En az 2 yıllık B sınıfı ehliyet gereklidir.\n• Kiralama süresince ek sürücü kaydı yapılabilir.\n• Detaylı sorularınız için destek ekibimizle iletişime geçebilirsiniz.",
			icon: "info",
			button: "Tamam"
		});
	});

	});


</script>