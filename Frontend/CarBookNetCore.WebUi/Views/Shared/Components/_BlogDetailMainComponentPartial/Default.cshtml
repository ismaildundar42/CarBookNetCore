@model GetBlogByIdDto

<div class="col-md-8 ftco-animate">

    <h2 class="mb-3">@Model.Title</h2>
    <div class="blog-content" style="white-space: pre-line;">
        @Model.Description
    </div>


    @await Component.InvokeAsync("_BlogDetailCloudeTagByBlogComponentPartial", new { id = ViewBag.BlogId })


    @await Component.InvokeAsync("_BlogDetailAuthorDetailComponentPartial", new { id = ViewBag.BlogId })


    <div class="pt-5 mt-5">
        <h3 class="mb-5">@ViewBag.CommentCount Yorum</h3>
        @await Component.InvokeAsync("_CommentListByBlogComponentPartial", new {id = ViewBag.BlogId})


        @await Component.InvokeAsync("_CommentAddComponentPartial")
    </div>

</div>
