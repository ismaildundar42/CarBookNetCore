@using CarBookNetCore.Dtos.PricingDtos
@model List<ResultPricingDto>
@{
    ViewData["Title"] = "Fiyat Bilgisi Atama";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-body p-4">

                        <div class="mb-4">
                            <h4 class="card-title text-primary fw-bold">Araca Fiyat Bilgisi Tanımlama</h4>
                            <p class="card-subtitle text-muted mb-4">
                                Seçili araç için kiralama fiyatlarını (Saatlik, Günlük, Haftalık, Aylık vb.) belirleyiniz.
                            </p>
                        </div>

                        <form method="post">
                            <input type="hidden" name="carId" value="@ViewBag.carId" />
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <div class="row mb-3 align-items-center">
                                    <input type="hidden" asp-for="@Model[i].PricingId" />
                                    <input type="hidden" asp-for="@Model[i].Name" />
                                    <div class="col-md-3">
                                        <label class="form-label font-weight-bold">@Model[i].Name Fiyatı (₺)</label>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="number" step="0.01" min="0" class="form-control" asp-for="@Model[i].Amount" placeholder="0.00" />
                                    </div>
                                </div>
                            }
                            <br />
                            <div class="d-flex gap-2">
                                <a href="/AdminCar/Index" class="btn btn-secondary mr-2">Vazgeç</a>
                                <button type="submit" class="btn btn-primary">
                                    Fiyat Bilgilerini Kaydet
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
