@model List<ResultCarPricingWithTimePeriodDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UiLayout/Index.cshtml";
}

<section class="ftco-section ftco-cart">
	<div class="container">
		<div class="row">
			<div class="col-md-12 ftco-animate">
				<div class="car-list">
					<table class="table">
						<thead class="thead-primary">
							<tr class="text-center">
								<th>&nbsp;</th>
								<th>&nbsp;</th>
								<th class="bg-dark heading">Günlük Kiralama Ücreti</th>
								<th class="bg-black heading">Haftalık Kiralama Ücreti</th>
								<th class="bg-black heading">Aylık Kiralama Ücreti</th>
							</tr>
						</thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="car-image">
                                        <div class="img"
                                             style="background-image:url('@item.CoverImageUrl');">
                                        </div>
                                    </td>

                                    <td class="product-name">
                                        <h3>@item.CarModel</h3>

                                        <p class="mb-0 rated">
                                            <span>Puan:</span>
                                            <span class="ion-ios-star"></span>
                                            <span class="ion-ios-star"></span>
                                            <span class="ion-ios-star"></span>
                                            <span class="ion-ios-star"></span>
                                            <span class="ion-ios-star"></span>
                                        </p>
                                    </td>

                                    <td class="price">
                                        <p class="btn-custom">
                                            <a href="#">Aracı Kirala</a>
                                        </p>

                                        <div class="price-rate">
                                            <h3>
                                                <span class="num">
                                                    @item.DailyAmount.ToString("N2") ₺
                                                </span>

                                                <span class="per">/ günlük</span>
                                            </h3>

                                            <span class="subheading">
                                                Günlük kiralama ücreti
                                            </span>
                                        </div>
                                    </td>

                                    <td class="price">
                                        <p class="btn-custom">
                                            <a href="#">Aracı Kirala</a>
                                        </p>

                                        <div class="price-rate">
                                            <h3>
                                                <span class="num">
                                                    @item.WeeklyAmount.ToString("N2") ₺
                                                </span>

                                                <span class="per">/ haftalık</span>
                                            </h3>

                                            <span class="subheading">
                                                Haftalık kiralama ücreti
                                            </span>
                                        </div>
                                    </td>

                                    <td class="price">
                                        <p class="btn-custom">
                                            <a href="#">Aracı Kirala</a>
                                        </p>

                                        <div class="price-rate">
                                            <h3>
                                                <span class="num">
                                                    @item.MonthlyAmount.ToString("N2") ₺
                                                </span>

                                                <span class="per">/ aylık</span>
                                            </h3>

                                            <span class="subheading">
                                                Aylık kiralama ücreti
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
					</table>
                    @if (ViewBag.TotalPages > 1)
                    {
                        <div class="row mt-5">
                            <div class="col text-center">
                                <div class="block-27">
                                    <ul>
                                        @if (ViewBag.CurrentPage > 1)
                                        {
                                            <li>
                                                <a asp-controller="CarPricing"
                                                   asp-action="Index"
                                                   asp-route-page="@(ViewBag.CurrentPage - 1)">
                                                    &lt;
                                                </a>
                                            </li>
                                        }

                                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                        {
                                            if (i == ViewBag.CurrentPage)
                                            {
                                                <li class="active">
                                                    <span>@i</span>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <a asp-controller="CarPricing"
                                                       asp-action="Index"
                                                       asp-route-page="@i">
                                                        @i
                                                    </a>
                                                </li>
                                            }
                                        }

                                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                        {
                                            <li>
                                                <a asp-controller="CarPricing"
                                                   asp-action="Index"
                                                   asp-route-page="@(ViewBag.CurrentPage + 1)">
                                                    &gt;
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
				</div>
			</div>
		</div>
	</div>
</section>

